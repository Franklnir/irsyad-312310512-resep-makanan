<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFE3A1">

    <androidx.cardview.widget.CardView
        android:id="@+id/recipe_card1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFEFD6"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_recipe1"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/streetboba"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_ingredients1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Bahan-Bahan:"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/img_recipe1" />

                <TextView
                    android:id="@+id/tv_ingredients_list1"
                    android:layout_width="338dp"
                    android:layout_height="222dp"
                    android:layout_marginTop="8dp"
                    android:text="        Street Boba Ala Cafe:\n\n- 1 liter susu segar full cream\n- 200 gram gula merah, iris halus\n- 50 gram boba instan (atau buat sendiri dengan tepung tapioka)\n- 3 sdm air matang untuk membuat sirup gula\n- 1 sdt bubuk teh hitam (opsional)\n- Es batu secukupnya untuk penyajian\n\nTambahan opsional:\n- 1 sdt ekstrak vanila untuk rasa manis ekstra\n- 1/4 sdt garam untuk menyeimbangkan rasa manis\n"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_ingredients1" />

                <TextView
                    android:id="@+id/tv_steps_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Langkah-Langkah Membuat:"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_ingredients_list1" />

                <TextView
                    android:id="@+id/tv_steps_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Siapkan semua bahan dengan benar. Pastikan boba sudah direbus sesuai petunjuk hingga kenyal.\n\n2. Panaskan gula merah dengan 3 sdm air hingga larut sepenuhnya dan membentuk sirup kental. Tambahkan sedikit ekstrak vanila untuk aroma.\n\n3. Rebus susu segar dengan api kecil (jangan sampai mendidih) jika Anda ingin menyajikan versi hangat. Untuk versi dingin, biarkan susu tetap dalam kondisi dingin.\n\n4. Ambil gelas saji, masukkan boba yang telah direbus ke bagian dasar gelas. Tambahkan sirup gula merah di atasnya sesuai selera.\n\n5. Tuangkan susu segar ke dalam gelas perlahan-lahan. Tambahkan bubuk teh hitam jika Anda ingin rasa teh yang ringan.\n\n6. Masukkan es batu secukupnya untuk minuman dingin. Aduk perlahan agar semua bahan tercampur rata.\n\n7. Street Boba Ala Cafe siap dinikmati! Hidangkan dengan sedotan besar agar lebih mudah meminum boba.\n"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_steps_title" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
