<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFE3A1">

    <androidx.cardview.widget.CardView
        android:id="@+id/recipe_card_thai"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFEFD6"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_recipe_thai"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/nasigoreng"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_ingredients_thai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Bahan-Bahan:"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/img_recipe_thai" />

                <TextView
                    android:id="@+id/tv_ingredients_list_thai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="- 2 porsi nasi putih (dingin lebih baik)\n- 2 butir telur\n- 200 gram udang kupas\n- 3 siung bawang putih, cincang halus\n- 1 batang daun bawang, iris halus\n- 2 sdm kecap ikan\n- 1 sdm saus tiram\n- 1 sdm kecap manis\n- 1/2 sdt gula\n- 1 buah jeruk nipis\n- Minyak goreng secukupnya\n- Irisan cabai dan ketimun untuk garnish"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_ingredients_thai" />

                <TextView
                    android:id="@+id/tv_steps_title_thai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Langkah-Langkah Memasak:"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_ingredients_list_thai" />

                <TextView
                    android:id="@+id/tv_steps_list_thai"
                    android:layout_width="333dp"
                    android:layout_height="824dp"
                    android:layout_marginTop="8dp"
                    android:text="1. Panaskan minyak di wajan, tumis bawang putih hingga harum.\n2. Masukkan udang, masak hingga berubah warna.\n3. Geser udang ke sisi wajan, lalu masukkan telur dan orak-arik.\n4. Tambahkan nasi putih, aduk rata.\n5. Masukkan kecap ikan, saus tiram, kecap manis, dan gula. Aduk rata.\n6. Tambahkan daun bawang, aduk sebentar.\n7. Sajikan dengan perasan jeruk nipis, irisan cabai, dan ketimun."
                    android:textColor="#000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_steps_title_thai" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
