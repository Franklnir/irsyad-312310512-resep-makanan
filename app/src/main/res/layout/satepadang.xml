<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFE3A1"> <!-- Background soft yellow -->

    <androidx.cardview.widget.CardView
        android:id="@+id/recipe_card1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFEFD6"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_recipe1"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/satepadang"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_ingredients1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Bahan-Bahan:"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/img_recipe1" />

                <TextView
                    android:id="@+id/tv_ingredients_list1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sate Padang:\n\n- 500 gram daging sapi (sandung lamur), potong kotak\n- 5 sdm tepung beras, larutkan dengan 200 ml air\n- 1 liter air kaldu sapi\n- 2 batang serai, memarkan\n- 5 lembar daun jeruk\n- 2 lembar daun kunyit, simpulkan\n- Garam secukupnya\n\nBumbu Halus:\n- 5 siung bawang putih\n- 8 butir bawang merah\n- 2 cm jahe\n- 2 cm kunyit\n- 5 buah cabai merah keriting\n- 1 sdt ketumbar\n- 1/2 sdt jinten\n- 1/2 sdt lada putih\n- 2 butir kemiri"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_ingredients1" />

                <TextView
                    android:id="@+id/tv_steps_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Langkah-Langkah Memasak:"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_ingredients_list1" />

                <TextView
                    android:id="@+id/tv_steps_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Haluskan semua bahan bumbu halus.\n2. Tumis bumbu halus bersama serai, daun jeruk, dan daun kunyit hingga harum.\n3. Masukkan potongan daging, aduk hingga berubah warna.\n4. Tuang air kaldu, masak hingga daging empuk.\n5. Larutkan tepung beras, masukkan ke dalam kuah sambil diaduk hingga mengental.\n6. Tusukkan daging pada tusuk sate.\n7. Panggang sate hingga harum dan sedikit kecokelatan.\n8. Sajikan sate padang bersama kuah kental.\n\nTips:\n- Gunakan tusuk sate dari bambu yang direndam air untuk mencegah pembakaran saat memanggang.\n- Kuah bisa disesuaikan tingkat kekentalannya dengan menambahkan tepung beras atau kaldu sesuai selera.\n- Daging yang digunakan bisa divariasikan dengan lidah sapi atau jeroan untuk cita rasa berbeda.\n- Nikmati sate padang dengan lontong sebagai pelengkap tradisional."
                    android:textColor="#000000"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_steps_title" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
