<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Gradient warna -->
            <gradient
                android:angle="0"
                android:startColor="#EAFFB0"
                android:centerColor="#FAE39A"
                android:endColor="#F0C343"
                android:type="linear" />

            <!-- Sudut melengkung -->
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
